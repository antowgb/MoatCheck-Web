# Supabase — get these in Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# CORS: frontend URL in prod (Vercel), comma-separated if multiple
FRONTEND_ORIGINS=http://localhost:3000

# Alpha Vantage — API key (free: https://www.alphavantage.co/support/#api-key)
# Free tier: 5 requests/minute, 25 requests/day. The refresh consumes
# 7 requests per ticker (OVERVIEW, INCOME_STATEMENT, BALANCE_SHEET, CASH_FLOW,
# EARNINGS, SPLITS, TIME_SERIES_WEEKLY) and 2 per benchmark (SPLITS +
# TIME_SERIES_WEEKLY, prices only) — i.e. ~3 tickers/day.
# NB: prices are WEEKLY (5-year daily is premium at AV).
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Finnhub — API key (free: https://finnhub.io/register), OPTIONAL. Without it,
# app.data.finnhub_client silently returns no data and build_quarterly_fundamentals
# falls back 100% to Alpha Vantage (unchanged behavior). With it, revenue/
# net_income/net_income_ttm/ebitda_ttm are substituted with Finnhub's own
# figures for a quarter, but ONLY when Finnhub's period-end date is within
# finnhub_client.FISCAL_DATE_TOLERANCE_DAYS of Alpha Vantage's fiscalDateEnding
# — see finnhub_client.py module docstring for the validated scope (capex,
# debt, cash, eps, pe_trailing stay on Alpha Vantage). Free tier: 60 req/min.
FINNHUB_API_KEY=your-finnhub-api-key

# Optional: path to the quota / resume tracking file (default:
# backend/refresh_progress.json). Add it to .gitignore.
# REFRESH_PROGRESS_FILE=./refresh_progress.json

# Admin key protecting POST /api/stocks (X-Admin-Key header) — since the site
# is public read-only, only the admin should be able to add tickers.
# Generate a random value, NEVER hardcode it in the code:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# In prod (Render), set this same variable in the service's env vars —
# don't commit it. Without this variable set, POST /api/stocks always
# returns 401 (fails closed).
ADMIN_API_KEY=your-random-admin-key
